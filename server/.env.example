# Optional: keep Octopus credentials entirely on the server for a personal deployment.
OCTOPUS_API_KEY=
OCTOPUS_ACCOUNT_NUMBER=

# Optional: OpenAI is the primary aggregate-only AI coach.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional fallback. Used when OpenAI fails, or as the primary provider when no
# OpenAI key is configured.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Private monthly report job. These names deliberately differ from the public
# dashboard variables so visitors cannot make requests with the owner's keys.
REPORT_OCTOPUS_API_KEY=
REPORT_OCTOPUS_ACCOUNT_NUMBER=
REPORT_OPENAI_API_KEY=
REPORT_OPENAI_MODEL=gpt-5.6-luna
RESEND_API_KEY=
REPORT_TO_EMAIL=you@example.com
REPORT_FROM_EMAIL=Pulse <onboarding@resend.dev>
REPORT_UNIT_RATE_PENCE=25.85
REPORT_STANDING_CHARGE_PENCE=60.89
REPORT_DASHBOARD_URL=https://octopus-energy-app-psi.vercel.app
CRON_SECRET=

PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
