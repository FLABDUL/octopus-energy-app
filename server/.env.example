# Optional: keep Octopus credentials entirely on the server for a personal deployment.
OCTOPUS_API_KEY=
OCTOPUS_ACCOUNT_NUMBER=

# Optional: OpenAI is the primary aggregate-only AI coach.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional fallback. Used when OpenAI fails, or as the primary provider when no
# OpenAI key is configured.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
